# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.playwright-mcp/

# Root-level screenshots (Playwright MCP, demo walkthroughs)
/*.png

# next.js
/.next/
/out/

# production
/build

# iOS build artifacts
ios/Equinet/build/

# misc
.DS_Store
*.pem

# editor lock files
.~lock.*
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# spike output
scripts/rls-spike/results.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# prisma
*.db
*.db-journal
prisma/dev.db

# chatloggar
/chatloggar/
*.txt

# Dev uploads (mock Supabase Storage)
/public/uploads/

# Backups
/backups/

# Sentry
.sentryclirc
sentry.properties
.env*.local

# Generated service worker (built from src/sw.ts)
public/sw.js
public/sw.js.map

# Git worktrees
.worktrees/

# Xcode
xcuserdata/
*.xcuserstate
DerivedData/

# Superpowers (per-machine)
.agents/
# Glob (not the directory) so the negations below can re-include tool skills.
# Tracked project skills (implement, retro, ...) stay tracked regardless.
.claude/skills/*
skills-lock.json

# BMAD + Impeccable (experimental dev tooling, see docs/guides/ai-dev-tools.md)
!.claude/skills/bmad-*/
!.claude/skills/impeccable/
# Platform binary: the launcher downloads the pinned, sha256-checked version
.claude/skills/impeccable/scripts/bin/
# Personal install answers (user_name, language)
_bmad/config.user.toml
# Generated artifacts and session logs; may describe unfixed vulnerabilities (public repo)
_bmad-output/
# Per-developer consent/settings and live-mode sessions
.impeccable/config.local.json
.impeccable/live/
# GitHub Copilot copy of Impeccable: not used; committing the hook would auto-run it for Copilot agents
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/impeccable.json

# E2E visual snapshots (generated, machine-specific)
e2e/__snapshots__/
e2e/*.spec.ts-snapshots/
s13-6-screenshots/

# Personal Claude Code config
CLAUDE.local.md

# Supabase local dev
supabase/.temp/
supabase/.branches/
supabase/.linked/

# Claude Code worktrees
.claude/worktrees/

# Playwright HTML reports + traces (regenererbara, stora, lint-trigger)
docs/metrics/e2e-visual/**/report/
docs/metrics/e2e-visual/**/traces/

.mcp.json

# design-sync (claude.ai/design) — regenerated build output + machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
